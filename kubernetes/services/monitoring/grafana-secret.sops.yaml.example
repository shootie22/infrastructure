apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: grafana-auth
  namespace: monitoring
spec:
  secretTemplates:
    - name: grafana-auth
      stringData:
        GF_SECURITY_ADMIN_USER: <human-supplied-admin-user>
        GF_SECURITY_ADMIN_PASSWORD: <human-supplied-admin-password>
        GF_AUTH_GENERIC_OAUTH_CLIENT_ID: <human-supplied-keycloak-client-id>
        GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: <human-supplied-keycloak-client-secret>
        GF_AUTH_GENERIC_OAUTH_SCOPES: openid profile email roles
        GF_AUTH_GENERIC_OAUTH_AUTH_URL: <existing-keycloak-auth-url>
        GF_AUTH_GENERIC_OAUTH_TOKEN_URL: <existing-keycloak-token-url>
        GF_AUTH_GENERIC_OAUTH_API_URL: <existing-keycloak-userinfo-url>
        GF_AUTH_GENERIC_OAUTH_USE_PKCE: "true"
        GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH: preferred_username
        GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH: full_name
        GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH: email
        GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH: contains(realm_access.roles[*], 'grafana-admin') && 'Admin' || contains(realm_access.roles[*], 'grafana-editor') && 'Editor' || 'Viewer'
# Encrypt secretTemplates with SOPS/Age before renaming this file to .yaml.
