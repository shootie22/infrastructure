apiVersion: apps/v1
kind: Deployment
metadata:
  name: savehub-worker
  namespace: savehub
  annotations:
    argocd.argoproj.io/sync-wave: '2'
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: savehub-worker
  template:
    metadata:
      labels:
        app: savehub-worker
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/hostname: thinkcentre
      securityContext:
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: worker
        image: "git.radunenu.com/radu/savehub@sha256:a7dc708db4e63580a3aea6ab062c9ff91b0a141d28cd7987f0826d61ea0614e8"
        command:
        - node
        - --import
        - tsx
        - apps/worker/src/main.ts
        env:
        - name: NODE_ENV
          value: production
        - name: APP_ORIGIN
          value: https://savehub.radunenu.com
        - name: STORAGE_ROOT
          value: /storage
        - name: OIDC_ISSUER
          value: https://auth.radunenu.com/realms/main
        - name: OIDC_CLIENT_ID
          value: savehub
        - name: TEST_AUTH
          value: 'false'
        envFrom:
        - configMapRef:
            name: savehub-config
        - secretRef:
            name: savehub-env
        resources:
          requests:
            cpu: 250m
            memory: 512Mi
          limits:
            cpu: '2'
            memory: 1536Mi
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
        volumeMounts:
        - name: storage
          mountPath: /storage
        - name: tmp
          mountPath: /tmp
        ports:
        - name: health
          containerPort: 3001
        readinessProbe:
          httpGet:
            path: /health/ready
            port: health
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /health/live
            port: health
          periodSeconds: 20
      volumes:
      - name: storage
        hostPath:
          path: /home/main/storage/savehub
          type: Directory
      - name: tmp
        emptyDir:
          sizeLimit: 1Gi
