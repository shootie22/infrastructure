apiVersion: apps/v1
kind: Deployment
metadata:
  name: savehub-api
  namespace: savehub
  annotations:
    argocd.argoproj.io/sync-wave: '2'
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: savehub-api
  template:
    metadata:
      labels:
        app: savehub-api
    spec:
      automountServiceAccountToken: false
      nodeSelector:
        kubernetes.io/hostname: thinkcentre
      securityContext:
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: api
        image: SAVEHUB_IMAGE_DIGEST
        command:
        - node
        - --import
        - tsx
        - apps/api/src/main.ts
        env:
        - name: NODE_ENV
          value: production
        - name: APP_ORIGIN
          value: https://savehub.radunenu.com
        - name: STORAGE_ROOT
          value: /storage
        - name: OIDC_ISSUER
          value: https://auth.radunenu.com/realms/main
        - name: OIDC_CLIENT_ID
          value: savehub
        - name: TEST_AUTH
          value: 'false'
        envFrom:
        - configMapRef:
            name: savehub-config
        - secretRef:
            name: savehub-env
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: '2'
            memory: 1Gi
        securityContext:
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
        volumeMounts:
        - name: storage
          mountPath: /storage
        - name: tmp
          mountPath: /tmp
        ports:
        - name: http
          containerPort: 3000
        readinessProbe:
          httpGet:
            path: /health/ready
            port: http
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /health/live
            port: http
          periodSeconds: 20
        startupProbe:
          httpGet:
            path: /health/live
            port: http
          failureThreshold: 30
          periodSeconds: 5
      volumes:
      - name: storage
        hostPath:
          path: /home/main/storage/savehub
          type: Directory
      - name: tmp
        emptyDir:
          sizeLimit: 1Gi
