apiVersion: isindir.github.com/v1alpha3
kind: SopsSecret
metadata:
  name: radunenu-com-stats
  namespace: radunenu-com
spec:
  secretTemplates:
    - name: radunenu-com-stats
      stringData:
        STATUS_API_TOKEN: <copied locally from the existing OVH runtime.env>
# Encrypt secretTemplates with SOPS/Age before renaming this file to .yaml.
