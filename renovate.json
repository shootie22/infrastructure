{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled"
  ],
  "timezone": "Europe/Bucharest",
  "schedule": [
    "* 1-7 * * 6"
  ],
  "labels": [
    "renovate"
  ],
  "prConcurrentLimit": 15,
  "prHourlyLimit": 0,
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/.+\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/argocd/.+\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/*.example",
    "services/**"
  ],
  "packageRules": [
    {
      "description": "Titles say what changes: 'Update gitea 1.27.3 \u2192 1.27.4'",
      "matchDatasources": [
        "docker",
        "helm",
        "github-releases",
        "github-tags",
        "terraform-provider"
      ],
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "{{#if isDigest}}(rebuilt image, same version {{currentValue}}){{else}}{{currentValue}} \u2192 {{newValue}}{{/if}}"
    },
    {
      "description": "Database major versions need a dump/restore or pg_upgrade, never just a new image. Planned by hand.",
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres",
        "clickhouse/clickhouse-server"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Pin images to tag@digest, so the version is readable and the build is exact",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Fast lane: these follow their newest build through in-cluster updaters (docs/updates.md)",
      "matchPackageNames": [
        "docker.io/vectorim/element-web",
        "git.radunenu.com/crosty/crosty-game-server",
        "git.radunenu.com/radu/bopl-2d-server",
        "git.radunenu.com/radu/radunenu.com-minimal",
        "git.radunenu.com/radu/radunenu.com-minimal-stats-updater",
        "git.radunenu.com/radu/infra-hub"
      ],
      "enabled": false
    },
    {
      "description": "The Minecraft server image tags its releases server-vX.Y.Z",
      "matchPackageNames": [
        "git.radunenu.com/radu/spigotmc-docker"
      ],
      "versioning": "regex:^server-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Major versions get their own label, they need reading before merging",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate",
        "major"
      ]
    },
    {
      "description": "Rebuilds of the same version (new digest, same tag) go into one weekly PR",
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "rebuilt images (same versions)",
      "commitMessageExtra": ""
    },
    {
      "matchPackageNames": [
        "docker.gitea.com/gitea"
      ],
      "sourceUrl": "https://github.com/go-gitea/gitea"
    },
    {
      "matchPackageNames": [
        "vaultwarden/server"
      ],
      "sourceUrl": "https://github.com/dani-garcia/vaultwarden"
    },
    {
      "matchPackageNames": [
        "joplin/server"
      ],
      "sourceUrl": "https://github.com/laurent22/joplin"
    },
    {
      "matchPackageNames": [
        "privatebin/unit-pdo"
      ],
      "sourceUrl": "https://github.com/PrivateBin/PrivateBin"
    },
    {
      "matchPackageNames": [
        "plantuml/plantuml-server"
      ],
      "sourceUrl": "https://github.com/plantuml/plantuml-server"
    },
    {
      "matchPackageNames": [
        "ghcr.io/juanfont/headscale"
      ],
      "sourceUrl": "https://github.com/juanfont/headscale"
    },
    {
      "matchPackageNames": [
        "ghcr.io/element-hq/element-call"
      ],
      "sourceUrl": "https://github.com/element-hq/element-call"
    },
    {
      "matchPackageNames": [
        "ghcr.io/advplyr/audiobookshelf"
      ],
      "sourceUrl": "https://github.com/advplyr/audiobookshelf"
    },
    {
      "matchPackageNames": [
        "registry.gitlab.com/timvisee/send"
      ],
      "sourceUrl": "https://gitlab.com/timvisee/send"
    },
    {
      "matchPackageNames": [
        "clickhouse/clickhouse-server"
      ],
      "sourceUrl": "https://github.com/ClickHouse/ClickHouse"
    },
    {
      "matchPackageNames": [
        "ckulka/baikal"
      ],
      "sourceUrl": "https://github.com/ckulka/baikal-docker"
    },
    {
      "description": "One weekly PR for every minor and patch update. Majors and the ones that need care stay separate.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!sops-secrets-operator",
        "!cert-manager",
        "!php",
        "!postgres",
        "!docker.io/library/postgres",
        "!clickhouse/clickhouse-server",
        "!ghcr.io/juanfont/headscale"
      ],
      "groupName": "service updates",
      "groupSlug": "service-updates"
    },
    {
      "description": "Need care: they hold or decrypt state, or everything depends on them. Always their own PR.",
      "matchPackageNames": [
        "sops-secrets-operator",
        "cert-manager",
        "php",
        "postgres",
        "clickhouse/clickhouse-server",
        "ghcr.io/juanfont/headscale"
      ],
      "labels": [
        "renovate",
        "careful"
      ]
    },
    {
      "description": "Minecraft servers: the Java tag follows the game version (Hub picks it), so only rebuilds of the same tag",
      "matchPackageNames": [
        "docker.io/itzg/minecraft-server"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ],
  "fetchChangeLogs": "pr",
  "customManagers": [
    {
      "description": "The image line in a hub.yaml Hub renders a service from, so Renovate moves it together with the deployment made from it (hub render --check would fail otherwise)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^kubernetes/services/[^/]+/hub\\.yaml$/"
      ],
      "matchStrings": [
        "(^|\\n)image: (?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
