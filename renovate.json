{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Bucharest",
  "labels": [
    "renovate"
  ],
  "prConcurrentLimit": 15,
  "prHourlyLimit": 0,
  "platformAutomerge": false,
  "automergeStrategy": "merge-commit",
  "kubernetes": {
    "managerFilePatterns": [
      "/^kubernetes/.+\\.ya?ml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/argocd/.+\\.ya?ml$/"
    ]
  },
  "ignorePaths": [
    "**/*.example",
    "services/**"
  ],
  "packageRules": [
    {
      "description": "Titles say what changes: 'Update gitea 1.27.3 \u2192 1.27.4'",
      "matchDatasources": [
        "docker",
        "helm",
        "github-releases",
        "github-tags",
        "terraform-provider"
      ],
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "{{currentValue}} \u2192 {{newValue}}"
    },
    {
      "description": "Database major versions need a dump/restore or pg_upgrade, never just a new image. Planned by hand.",
      "matchPackageNames": [
        "postgres",
        "docker.io/library/postgres"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "ClickHouse: LTS lines only (YY.3 and YY.8), the ones supported for a year. Its major is just the year, and a new LTS is an image change, not a dump/restore.",
      "matchPackageNames": [
        "clickhouse/clickhouse-server"
      ],
      "allowedVersions": "/^\\d+\\.(3|8)\\.\\d+\\.\\d+$/"
    },
    {
      "description": "uptimerobot 2.0.0 was published and then withdrawn; upstream says to stay below 2 (uptimerobot/terraform-provider-uptimerobot#299)",
      "matchDepNames": [
        "uptimerobot"
      ],
      "allowedVersions": "<2.0.0"
    },
    {
      "description": "Pin images to tag@digest, so the version is readable and the build is exact",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Fast lane: these follow their newest build through in-cluster updaters (docs/updates.md)",
      "matchPackageNames": [
        "docker.io/vectorim/element-web",
        "git.radunenu.com/crosty/crosty-game-server",
        "git.radunenu.com/radu/bopl-2d-server",
        "git.radunenu.com/radu/gamevault-server",
        "git.radunenu.com/radu/infra-hub"
      ],
      "enabled": false
    },
    {
      "description": "The Minecraft server image tags its releases server-vX.Y.Z",
      "matchPackageNames": [
        "git.radunenu.com/radu/spigotmc-docker"
      ],
      "versioning": "regex:^server-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Major versions get their own label, they need reading before merging",
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "renovate",
        "major"
      ]
    },
    {
      "description": "Rebuilds of the same version (new digest, same tag) go into one weekly PR",
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "rebuilt images (same versions)",
      "commitMessageExtra": ""
    },
    {
      "matchPackageNames": [
        "docker.gitea.com/gitea"
      ],
      "sourceUrl": "https://github.com/go-gitea/gitea"
    },
    {
      "matchPackageNames": [
        "vaultwarden/server"
      ],
      "sourceUrl": "https://github.com/dani-garcia/vaultwarden"
    },
    {
      "matchPackageNames": [
        "joplin/server"
      ],
      "sourceUrl": "https://github.com/laurent22/joplin"
    },
    {
      "matchPackageNames": [
        "privatebin/unit-pdo"
      ],
      "sourceUrl": "https://github.com/PrivateBin/PrivateBin"
    },
    {
      "matchPackageNames": [
        "plantuml/plantuml-server"
      ],
      "sourceUrl": "https://github.com/plantuml/plantuml-server"
    },
    {
      "matchPackageNames": [
        "ghcr.io/juanfont/headscale"
      ],
      "sourceUrl": "https://github.com/juanfont/headscale"
    },
    {
      "matchPackageNames": [
        "ghcr.io/element-hq/element-call"
      ],
      "sourceUrl": "https://github.com/element-hq/element-call"
    },
    {
      "matchPackageNames": [
        "ghcr.io/advplyr/audiobookshelf"
      ],
      "sourceUrl": "https://github.com/advplyr/audiobookshelf"
    },
    {
      "matchPackageNames": [
        "registry.gitlab.com/timvisee/send"
      ],
      "sourceUrl": "https://gitlab.com/timvisee/send"
    },
    {
      "matchPackageNames": [
        "clickhouse/clickhouse-server"
      ],
      "sourceUrl": "https://github.com/ClickHouse/ClickHouse"
    },
    {
      "matchPackageNames": [
        "ckulka/baikal"
      ],
      "sourceUrl": "https://github.com/ckulka/baikal-docker"
    },
    {
      "description": "One weekly PR for every minor and patch update. Majors and the ones that need care stay separate.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!sops-secrets-operator",
        "!cert-manager",
        "!php",
        "!postgres",
        "!docker.io/library/postgres",
        "!clickhouse/clickhouse-server",
        "!ghcr.io/juanfont/headscale",
        "!joplin/server"
      ],
      "groupName": "service updates",
      "groupSlug": "service-updates"
    },
    {
      "description": "Updates to the workflows themselves get their own PR: GitHub's built-in token can't push changes to .github/workflows, and one such file kept the whole service updates group from being created",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "workflow actions",
      "groupSlug": "workflow-actions"
    },
    {
      "description": "Action patches and new digests of the same tag merge themselves once the checks pass; minor updates wait for me in their own PR",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "workflow actions (minor)",
      "groupSlug": "workflow-actions-minor"
    },
    {
      "description": "Need care: they hold or decrypt state, or everything depends on them. Always their own PR.",
      "matchPackageNames": [
        "sops-secrets-operator",
        "cert-manager",
        "php",
        "postgres",
        "clickhouse/clickhouse-server",
        "ghcr.io/juanfont/headscale",
        "joplin/server"
      ],
      "labels": [
        "renovate",
        "careful"
      ]
    },
    {
      "description": "Merge themselves once every check on the PR has passed, as long as the tag names a version: patch updates, rebuilds of the same version and pinning a digest (docs/updates.md). Minor and major updates, moving tags (main, latest, java25) and the packages below still wait for me.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pinDigest"
      ],
      "matchCurrentValue": "/^v?\\d+(\\.\\d+)+/",
      "matchPackageNames": [
        "!/postgres/",
        "!/cloudnative-pg/",
        "!/clickhouse/",
        "!/redis/",
        "!/gitea/",
        "!/keycloak/",
        "!/k3s/",
        "!/argoproj/",
        "!/argo-cd/",
        "!cert-manager",
        "!sops-secrets-operator",
        "!php",
        "!ghcr.io/juanfont/headscale",
        "!joplin/server",
        "!git.radunenu.com/radu/infra-hub",
        "!docker.io/itzg/minecraft-server",
        "!git.radunenu.com/radu/spigotmc-docker",
        "!git.radunenu.com/radu/steamhappy",
        "!indifferentbroccoli/hytale-server-docker",
        "!docker.io/phalcode/gamevault-backend"
      ],
      "automerge": true
    },
    {
      "description": "Image patches get their own PR, so a minor update in service updates doesn't hold them back",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchPackageNames": [
        "!/postgres/",
        "!/cloudnative-pg/",
        "!/clickhouse/",
        "!/redis/",
        "!/gitea/",
        "!/keycloak/",
        "!/k3s/",
        "!/argoproj/",
        "!/argo-cd/",
        "!cert-manager",
        "!sops-secrets-operator",
        "!php",
        "!ghcr.io/juanfont/headscale",
        "!joplin/server",
        "!git.radunenu.com/radu/infra-hub",
        "!docker.io/itzg/minecraft-server",
        "!git.radunenu.com/radu/spigotmc-docker",
        "!git.radunenu.com/radu/steamhappy",
        "!indifferentbroccoli/hytale-server-docker",
        "!docker.io/phalcode/gamevault-backend"
      ],
      "groupName": "service patches",
      "groupSlug": "service-patches"
    },
    {
      "description": "New builds of a moving tag aren't the same version rebuilt, so they wait for me in their own PR",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "matchCurrentValue": "!/^v?\\d+(\\.\\d+)+/",
      "groupName": "rebuilt images (careful)",
      "labels": [
        "renovate",
        "careful"
      ]
    },
    {
      "description": "Never merge themselves: databases, Gitea and its runners, Keycloak, k3s, Argo CD, cert-manager, sops-secrets-operator, the ones labelled careful above, and the game servers (a restart kicks the players). Their rebuilds go together in one PR.",
      "matchPackageNames": [
        "/postgres/",
        "/cloudnative-pg/",
        "/clickhouse/",
        "/redis/",
        "/gitea/",
        "/keycloak/",
        "/k3s/",
        "/argoproj/",
        "/argo-cd/",
        "cert-manager",
        "sops-secrets-operator",
        "php",
        "ghcr.io/juanfont/headscale",
        "joplin/server",
        "git.radunenu.com/radu/infra-hub",
        "docker.io/itzg/minecraft-server",
        "git.radunenu.com/radu/spigotmc-docker",
        "git.radunenu.com/radu/steamhappy",
        "indifferentbroccoli/hytale-server-docker",
        "docker.io/phalcode/gamevault-backend"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "/postgres/",
        "/cloudnative-pg/",
        "/clickhouse/",
        "/redis/",
        "/gitea/",
        "/keycloak/",
        "/k3s/",
        "/argoproj/",
        "/argo-cd/",
        "cert-manager",
        "sops-secrets-operator",
        "php",
        "ghcr.io/juanfont/headscale",
        "joplin/server",
        "git.radunenu.com/radu/infra-hub",
        "docker.io/itzg/minecraft-server",
        "git.radunenu.com/radu/spigotmc-docker",
        "git.radunenu.com/radu/steamhappy",
        "indifferentbroccoli/hytale-server-docker",
        "docker.io/phalcode/gamevault-backend"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "rebuilt images (careful)",
      "labels": [
        "renovate",
        "careful"
      ]
    },
    {
      "description": "Minecraft servers: the Java tag follows the game version (Hub picks it), so only rebuilds of the same tag",
      "matchPackageNames": [
        "docker.io/itzg/minecraft-server"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    },
    {
      "description": "hub-writer holds the GitHub App key, so unlike the rest of Hub (fast lane) it's pinned, and each new build is its own PR",
      "matchPackageNames": [
        "git.radunenu.com/radu/infra-hub"
      ],
      "matchFileNames": [
        "kubernetes/services/hub/writer.yaml"
      ],
      "enabled": true,
      "groupName": "hub-writer",
      "commitMessageTopic": "hub-writer",
      "commitMessageExtra": "(new infra-hub main build)",
      "labels": [
        "renovate",
        "careful"
      ]
    },
    {
      "description": "radunenu.com's two images are pinned and released together (v* tags), so one PR moves both",
      "matchPackageNames": [
        "git.radunenu.com/radu/radunenu.com-minimal",
        "git.radunenu.com/radu/radunenu.com-minimal-stats-updater"
      ],
      "groupName": "radunenu.com",
      "groupSlug": "radunenu-com"
    },
    {
      "description": "GameVault's server and the web UI it downloads at start (gamevault/deployment.yaml, WEB_UI_VERSION) go out together, as upstream releases them",
      "matchPackageNames": [
        "docker.io/phalcode/gamevault-backend",
        "Phalcode/gamevault-frontend"
      ],
      "groupName": "GameVault"
    }
  ],
  "fetchChangeLogs": "pr",
  "customManagers": [
    {
      "description": "The image line in a hub.yaml Hub renders a service from, so Renovate moves it together with the deployment made from it (hub render --check would fail otherwise)",
      "customType": "regex",
      "managerFilePatterns": [
        "/^kubernetes/services/[^/]+/hub\\.yaml$/"
      ],
      "matchStrings": [
        "(^|\\n)image: (?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "A plain setting with a '# renovate: datasource=... depName=...' comment on the line above it, like GameVault's WEB_UI_VERSION",
      "customType": "regex",
      "managerFilePatterns": [
        "/^kubernetes/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*[A-Z_]+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ]
}
