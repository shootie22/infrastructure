#!/usr/bin/env bash
# Creates tofu/secrets.sops.yaml with the Cloudflare token, the Hetzner token
# and a generated passphrase for OpenTofu's state encryption.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v sops >/dev/null; then
  printf 'sops is required; run with: nix shell nixpkgs#sops -c %s\n' "$0" >&2
  exit 1
fi

target=tofu/secrets.sops.yaml
if [[ -e "$target" ]]; then
  printf 'Refusing to overwrite %s\n' "$target" >&2
  exit 1
fi
mkdir -p tofu

ask() {
  local prompt=$1 value
  read -r -s -p "$prompt (input hidden): " value
  printf '\n' >&2
  if [[ ! "$value" =~ ^[A-Za-z0-9_-]+$ ]]; then
    printf 'Empty or unexpected characters; no file was created.\n' >&2
    exit 1
  fi
  printf '%s' "$value"
}

cloudflare=$(ask 'Cloudflare API token')
hcloud=$(ask 'Hetzner API token')
passphrase=$(head -c 36 /dev/urandom | base64 | tr -d '/+=\n')

umask 077
tmp=$(mktemp "${target}.XXXXXX")
trap 'rm -f "$tmp"' EXIT

cat <<YAML | sops --encrypt --filename-override "$target" --input-type yaml --output-type yaml /dev/stdin > "$tmp"
cloudflare_api_token: $cloudflare
hcloud_token: $hcloud
state_passphrase: $passphrase
YAML

mv "$tmp" "$target"
trap - EXIT
printf 'Wrote %s\n' "$target"
