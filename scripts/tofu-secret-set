#!/usr/bin/env bash
# Adds or replaces one value in tofu/secrets.sops.yaml without showing it.
# Usage: scripts/tofu-secret-set desec_token
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if ! command -v sops >/dev/null; then
  printf 'sops is required; run with: nix shell nixpkgs#sops -c %s <key>\n' "$0" >&2
  exit 1
fi

key=${1:-}
if [[ ! "$key" =~ ^[a-z0-9_]+$ ]]; then
  printf 'Usage: %s <key>, e.g. desec_token\n' "$0" >&2
  exit 1
fi

read -r -s -p "$key (input hidden): " value
printf '\n' >&2
if [[ ! "$value" =~ ^[A-Za-z0-9_.-]+$ ]]; then
  printf 'Empty or unexpected characters; nothing was changed.\n' >&2
  exit 1
fi

sops set tofu/secrets.sops.yaml "[\"$key\"]" "\"$value\""
printf 'Set %s in tofu/secrets.sops.yaml\n' "$key"
